<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AppleKeyboards</key>
	<array>
		<string>en_US@hw=Automatic;sw=QWERTY</string>
		<string>az_Latn@hw=Automatic;sw=QWERTY</string>
	</array>
	<key>AppleKeyboardsExpanded</key>
	<integer>1</integer>
	<key>AppleLanguages</key>
	<array>
		<string>en-US</string>
		<string>az-AZ</string>
	</array>
	<key>AppleLocale</key>
	<string>en_US</string>
	<key>AppleICUForce24HourTime</key>
	<true/>
	<key>AppleTemperatureUnit</key>
	<string>Celsius</string>
	<key>AppleMeasurementUnits</key>
	<string>Centimeters</string>
	<key>AppleMetricUnits</key>
	<true/>
</dict>
</plist>
